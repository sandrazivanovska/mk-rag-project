# ── LLM API Keys ──────────────────────────────────────────────────────────────
# Gemini is the active provider. Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=AIza...

# Optional — only needed if you switch GENERATOR_IDS back to gpt4o / claude_sonnet.
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# ── Google Translate API ───────────────────────────────────────────────────────
# Either use a service account JSON file OR an API key
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# GOOGLE_TRANSLATE_API_KEY=AIza...

# ── Model Selection ────────────────────────────────────────────────────────────
GEMINI_MODEL=gemini-2.5-pro
GEMINI_MODEL_FAST=gemini-2.5-flash
# Thinking tokens count against this; 512 truncated Pro mid-answer.
GEN_MAX_TOKENS=4096

# Which generators run. JSON list (pydantic-settings parses complex types as JSON).
GENERATOR_IDS=["gemini_flash","gemini_pro"]

# RAGAS judge: "gemini" or "openai"
JUDGE_PROVIDER=gemini
JUDGE_MODEL=gemini-2.5-flash
# RAGAS costs ~270k prompt tokens/sample and dominates spend.
# Score it on this many questions per pipeline (0/blank = all).
RAGAS_SAMPLE=40
RAGAS_SEED=42

OPENAI_MODEL=gpt-4o
ANTHROPIC_MODEL=claude-sonnet-4-5

# ── Vertex AI (workaround for "AQ." keys the Gemini API rejects) ───────────────
# Set USE_VERTEX=true to auth with Google Cloud instead of an API key.
# Uses your $300 trial credit. Needs the Vertex AI API enabled on the project.
USE_VERTEX=false
VERTEX_PROJECT=
VERTEX_LOCATION=us-central1
# Path to a service-account JSON with the "Vertex AI User" role:
# GOOGLE_APPLICATION_CREDENTIALS=C:/Users/user/keys/vertex-sa.json

# ── Retrieval Settings ─────────────────────────────────────────────────────────
EMBED_MODEL_PRIMARY=BAAI/bge-m3
EMBED_MODEL_BASELINE=intfloat/multilingual-e5-large-instruct
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

TOP_K_RETRIEVAL=50
TOP_K_RERANK=5

# ── Data Paths ─────────────────────────────────────────────────────────────────
MK_WIKI_DUMP_PATH=data/raw/mk/mkwiki-latest-pages-articles.xml.bz2
EN_WIKI_PATH=data/raw/en/
MK_CORPUS_PATH=data/raw/mk/
PROCESSED_MK_PATH=data/processed/mk/
PROCESSED_EN_PATH=data/processed/en/
FAISS_INDEX_MK=data/indices/faiss/mk_bge_m3.index
FAISS_INDEX_EN=data/indices/faiss/en_bge_m3.index
BM25_INDEX_MK=data/indices/bm25/mk/
BM25_INDEX_EN=data/indices/bm25/en/

# ── Chunking Settings ──────────────────────────────────────────────────────────
CHUNK_SIZE=384
CHUNK_OVERLAP=64
CHUNKING_STRATEGY=sentence   # options: sentence | fixed | paragraph

# ── Experiment ─────────────────────────────────────────────────────────────────
EXPERIMENT_OUTPUT_DIR=results/
LOG_LEVEL=INFO
